EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# EXPO_PUBLIC_SUPABASE_KEY is also supported if you prefer the shorter name.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Birthplace search uses Photon (OpenStreetMap), which needs no key. Point this at a self-hosted
# Photon for heavy traffic; leave empty to use the public server (photon.komoot.io, fair use).
EXPO_PUBLIC_PHOTON_URL=
# Hosted privacy policy and terms (the same URLs you give the app stores, Google and Meta). When
# set, the app opens them in the browser; when empty it shows the built-in copies in
# constants/legal.ts.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
# Social sign-in buttons to show on the welcome screen: any of google,facebook,apple.
# Leave empty until the provider is enabled in Supabase (Authentication → Providers).
EXPO_PUBLIC_SOCIAL_AUTH_PROVIDERS=
# Only for the optional native Google Sign-In adapter (services/auth/index.ts).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
