SUPABASE_PROJECT_REF=your-project-ref
FCM_SERVER_KEY=your_fcm_server_key
# Payments: "dummy" (no money moves; also needs PAYMENTS_ALLOW_DUMMY=true) or "razorpay".
PAYMENT_PROVIDER=dummy
PAYMENTS_ALLOW_DUMMY=true
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Social sign-in (only needed for local `supabase start`; hosted projects configure these in
# the dashboard under Authentication → Providers).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_web_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_client_secret
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=your_meta_app_id
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=your_meta_app_secret
