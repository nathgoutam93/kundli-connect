{
  "name": "kundali-konnect",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:web": "npm --prefix apps/mobile run web",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "supabase:link": "set -a; . ./.env; set +a; supabase link --project-ref \"$SUPABASE_PROJECT_REF\"",
    "supabase:db:push": "supabase db push",
    "supabase:functions:deploy": "supabase functions deploy generate-kundli && supabase functions deploy generate-match-score && supabase functions deploy create-like && supabase functions deploy reply-to-like && supabase functions deploy send-push-notification"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "supabase": "^2.103.0",
    "typescript": "^5.9.3"
  }
}
